 void ProxyWindowBase::deleteWindow(bool keepItemOwnership) {
 	if (this->window != nullptr) emit this->windowDestroyed();
-	if (auto* window = this->disownWindow(keepItemOwnership)) window->deleteLater();
+	if (auto* window = this->disownWindow(keepItemOwnership)) {
+		// Deleting the backing window straight from inside a deferred delete batch would
+		// destroy the window immediately, while the QML item tree it backs (including the
+		// QQuickShaderEffectSource Qt creates for `layer.enabled`) is still alive and still
+		// holding a QQuickWindow* to it. Those items are torn down moments later and crash in
+		// QQuickItemPrivate::dirty() -> QQuickWindow::maybeUpdate() on the freed window.
+		// Defer to the next event loop iteration so the items are gone before the window is.
+		QTimer::singleShot(0, window, [window]() { window->deleteLater(); });
+	}
 }
 
