// --- Input Configuration ---
input {
    focus-follows-mouse
    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
        }
        numlock
        repeat-delay 250
        repeat-rate 50
    }
    touchpad {
        tap
        natural-scroll
    }
}

switch-events {
    lid-close { spawn "python3" "/home/patrick/.config/niri/niri-display-monitor.py" "--lid-close"; }
    lid-open { spawn "python3" "/home/patrick/.config/niri/niri-display-monitor.py" "--lid-open"; }
}
