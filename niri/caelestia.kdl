spawn-sh-at-startup "qs -c niri-caelestia-shell"

binds {

    Mod+Space repeat=false { spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle launcher"; }
    Mod+D hotkey-overlay-title="Toggle Dashboard" {spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle dashboard";}
    Mod+I hotkey-overlay-title="Toggle Nexus" {spawn-sh "qs -c niri-caelestia-shell ipc call nexus open";}
    Mod+L allow-when-locked=true hotkey-overlay-title="Lock screen" { spawn-sh "qs -c niri-caelestia-shell ipc call lock lock"; }
    Mod+V repeat=false hotkey-overlay-title="Toggle Clipboard" { spawn-sh "qs -c niri-caelestia-shell ipc call clipboard open"; }
    Mod+W repeat=false hotkey-overlay-title="Change Wallpaper" { spawn-sh "qs -c niri-caelestia-shell ipc call wallpaper open"; }
    Ctrl+Alt+Delete {spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle session"; }
    Mod+Escape {spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle session"; }
    Mod+P repeat=false hotkey-overlay-title="Display Switcher" { spawn-sh "qs -c niri-caelestia-shell ipc call display toggle"; }
    Mod+A repeat=false hotkey-overlay-title="Toggle Sound Panel" { spawn-sh "qs -c niri-caelestia-shell ipc call soundPanel toggle"; }

    // Region picker
    Mod+Shift+S hotkey-overlay-title="Screenshot" { spawn-sh "qs -c niri-caelestia-shell ipc call picker openFreeze"; }
    Mod+Shift+X hotkey-overlay-title="Region OCR" { spawn-sh "qs -c niri-caelestia-shell ipc call picker regionOcr"; }
    Mod+Shift+A hotkey-overlay-title="Region Search" { spawn-sh "qs -c niri-caelestia-shell ipc call picker regionSearch"; }

    // Volume (hardware keys)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    Alt+XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+"; }
    Alt+XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // Brightness (hardware keys)
    XF86MonBrightnessUp {spawn-sh "qs -c niri-caelestia-shell ipc call brightness set +5%"; }
    XF86MonBrightnessDown {spawn-sh "qs -c niri-caelestia-shell ipc call brightness set 5%-"; }
    Alt+XF86MonBrightnessUp {spawn-sh "qs -c niri-caelestia-shell ipc call brightness set +1%"; }
    Alt+XF86MonBrightnessDown {spawn-sh "qs -c niri-caelestia-shell ipc call brightness set 1%-"; }

    // Utilities and Notifications
    Mod+N hotkey-overlay-title="Toggle Utilities" {spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle utilities";}
    Mod+Shift+N hotkey-overlay-title="Toggle Notifications" {spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle sidebar";}

    // Manga and Novel Reader
    Mod+M hotkey-overlay-title="Manga Reader" {spawn-sh "qs -c niri-caelestia-shell ipc call mangaReader toggle";}
    Mod+Shift+M hotkey-overlay-title="Novel Reader" {spawn-sh "qs -c niri-caelestia-shell ipc call novelReader toggle";}
}

layer-rule {
    match namespace="quickshell:Backdrop"
    place-within-backdrop true
    opacity 1.0
}
